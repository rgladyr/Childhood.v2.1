# =========================================================
# .editorconfig
# =========================================================
# Этот файл — детерминированная половина проверки стиля.
# Что НЕ покрывается тут (§2 переносы составных выражений, §11 переносы
# параметров с присваиванием, §2 throw/new выравнивание, §3 запрет
# сокращений типа res/usr/msg, §4 структура папок Abstractions/Base,
# §6 порядок методов, §7 правила XML-доков, §12 вынос констант)
# — остаётся за скиллами csharp-formatting / csharp-structure и т.д.
#
# Severity:
#   error      → блокирует билд
#   warning    → видно в выводе билда, не блокирует
#   suggestion → подсветка только в IDE
#   silent     → отключено
# =========================================================

root = true

# ---------- Общие настройки для всех файлов ----------
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# =========================================================
# C# — основные правила
# =========================================================
[*.cs]
indent_size = 4
tab_width = 4
max_line_length = 140

# ---------- §2: var ----------
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error

# ---------- §9: this. / base. (явные квалификаторы) ----------
dotnet_style_qualification_for_field = true:error
dotnet_style_qualification_for_property = true:error
dotnet_style_qualification_for_method = true:error
dotnet_style_qualification_for_event = true:error

# ---------- §10: фигурные скобки ----------
csharp_prefer_braces = true:error
# using-блок предпочтительнее using-declaration (§10)
csharp_prefer_simple_using_statement = false:warning

# ---------- §2: expression-bodied ----------
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = false:warning

# ---------- §13: string comparison ----------
# Анализаторы CA из Microsoft.CodeAnalysis.NetAnalyzers
dotnet_diagnostic.CA1307.severity = error  # specify StringComparison for clarity
dotnet_diagnostic.CA1309.severity = error  # use ordinal StringComparison
dotnet_diagnostic.CA1310.severity = error  # specify StringComparison for correctness
dotnet_diagnostic.CA1862.severity = error  # use 'StringComparison' overloads

# ---------- §5: using ----------
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_using_directive_placement = outside_namespace:error

# ---------- §6: sealed для классов без наследников ----------
dotnet_diagnostic.CA1852.severity = warning

# ---------- §8: атрибуты в отдельных скобках ----------
# Требует пакет StyleCop.Analyzers
dotnet_diagnostic.SA1133.severity = error  # do not combine attributes

# ---------- Регламент code-style.md не требует file header ----------
dotnet_diagnostic.SA1633.severity = none  # file header missing

# ---------- §6: порядок блоков класса и методов ----------
# Регламент: поля→свойства→конструкторы→методы (StyleCop хочет другой порядок).
# Регламент: protected→private→public (StyleCop хочет public первым).
# Регламент имеет приоритет над .editorconfig — отключаем противоречащие.
dotnet_diagnostic.SA1201.severity = none  # ordering of class elements
dotnet_diagnostic.SA1202.severity = none  # ordering of access modifiers

# ---------- Публичные поля не запрещены регламентом §3 ----------
dotnet_diagnostic.SA1401.severity = none  # field should be private

# ---------- Регламент §7 не требует «Gets/Sets/Initializes a new instance» ----------
dotnet_diagnostic.SA1623.severity = none  # property doc should begin with Gets/Sets
dotnet_diagnostic.SA1642.severity = none  # constructor doc should begin with "Initializes a new instance"
dotnet_diagnostic.SA1643.severity = none  # destructor doc should begin with "Finalizes an instance"

# ---------- Регламент §6 разрешает ClassName.PartName.cs (partial) ----------
dotnet_diagnostic.SA1649.severity = none  # file name should match first type name

# ---------- §6 не требует readonly-first ----------
dotnet_diagnostic.SA1214.severity = none  # readonly fields should appear before non-readonly

# ---------- IDE0007 (var) уже регулируется csharp_style_var_* выше ----------

# ---------- §1: не удалять «неиспользуемое» (защита) ----------
# IDE0051 — unused private member. Понижаем до suggestion, чтобы Claude
# не удалял инфраструктурный код.
dotnet_diagnostic.IDE0051.severity = suggestion
dotnet_diagnostic.IDE0052.severity = suggestion
dotnet_diagnostic.CA1812.severity = suggestion  # avoid uninstantiated internal classes

# ---------- §2: throw expression — ВЫКЛ (правила требуют throw new ...) ----------
csharp_style_throw_expression = false:warning

# ---------- Pattern matching ----------
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# ---------- Null ----------
csharp_style_conditional_delegate_call = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning

# ---------- Modifiers ----------
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning
dotnet_style_readonly_field = true:warning

# ---------- Newline rules ----------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# ---------- Indentation ----------
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = no_change
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents_when_block = false

# ---------- Spacing ----------
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false

# ---------- Wrapping ----------
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# =========================================================
# Naming rules (§3)
# =========================================================

# --- Стили ---
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case

dotnet_naming_style.t_prefix.required_prefix = T
dotnet_naming_style.t_prefix.capitalization = pascal_case

# --- Символы ---
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

dotnet_naming_symbols.types.applicable_kinds = class,struct,enum,delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private,protected,protected_internal,private_protected

dotnet_naming_symbols.public_members.applicable_kinds = property,method,event
dotnet_naming_symbols.public_members.applicable_accessibilities = public,internal,protected,protected_internal

dotnet_naming_symbols.parameters.applicable_kinds = parameter

dotnet_naming_symbols.locals.applicable_kinds = local

# --- Правила ---

# Интерфейсы — IPascalCase
dotnet_naming_rule.interfaces_must_start_with_i.severity = error
dotnet_naming_rule.interfaces_must_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_must_start_with_i.style = i_prefix

# Type parameters — TPascalCase
dotnet_naming_rule.type_parameters_must_start_with_t.severity = error
dotnet_naming_rule.type_parameters_must_start_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_must_start_with_t.style = t_prefix

# Типы — PascalCase
dotnet_naming_rule.types_pascal.severity = error
dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal_case

# Константы — PascalCase
dotnet_naming_rule.constants_pascal.severity = error
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case

# static readonly — PascalCase
dotnet_naming_rule.static_readonly_pascal.severity = error
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal_case

# Public/protected/internal члены — PascalCase
dotnet_naming_rule.public_members_pascal.severity = error
dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal_case

# private поля — camelCase (без подчёркивания, по правилам skill)
dotnet_naming_rule.private_fields_camel.severity = error
dotnet_naming_rule.private_fields_camel.symbols = private_fields
dotnet_naming_rule.private_fields_camel.style = camel_case

# Параметры — camelCase
dotnet_naming_rule.parameters_camel.severity = error
dotnet_naming_rule.parameters_camel.symbols = parameters
dotnet_naming_rule.parameters_camel.style = camel_case

# Локальные переменные — camelCase
dotnet_naming_rule.locals_camel.severity = error
dotnet_naming_rule.locals_camel.symbols = locals
dotnet_naming_rule.locals_camel.style = camel_case
